{
    "name": "astro",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "turbo dev:frontend dev:backend",
        "dev:frontend": "next dev",
        "dev:backend": "convex dev",
        "codegen": "convex codegen",
        "generate": "openapi-typescript https://astrocalc-api.onrender.com/openapi.json -o types/apis/astrocalc.d.ts --root-types",
        "build": "turbo :build",
        ":build": "next build",
        "deploy": "convex deploy --cmd \"bun run build\"",
        "start": "next start",
        "lint": "tsc --noEmit && eslint"
    },
    "dependencies": {
        "@clerk/nextjs": "^7.5.13",
        "@clerk/ui": "^1.24.2",
        "@tanstack/react-form": "^1.33.0",
