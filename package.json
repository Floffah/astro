        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "convex": "^1.42.1",
        "convex-env": "^3.0.0",
        "lucide-react": "^1.23.0",
        "motion": "^12.42.2",
        "next": "16.2.10",
        "next-themes": "^0.4.6",
        "openapi-fetch": "^0.17.0",
        "radix-ui": "^1.6.1",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "shadcn": "^4.13.0",
        "sonner": "^2.0.7",
        "svix": "^1.96.1",
        "tailwind-merge": "^3.6.0",
        "tw-animate-css": "^1.4.0",
        "valtio": "^2.3.2",
        "xstate": "^5.32.4",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@convex-dev/eslint-plugin": "^2.0.0",
